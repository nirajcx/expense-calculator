# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker

# ──────────────────────────────────────────────
# JWT (JSON Web Token) Configuration
# ──────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256

# Access token expires in 30 minutes (value in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expires in 7 days (value in days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────
APP_NAME=Expense Tracker API
APP_VERSION=1.0.0
DEBUG=true
